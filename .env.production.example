# ==========================================
# Production — thermosolver.net (HTTPS)
# ==========================================
# Template for: make setup-production
# Creates .env on the server (never commit .env).
#
# Public site: https://thermosolver.net
# Nginx: :80 → redirect to HTTPS; :443 TLS (docker/nginx/ssl/cert.pem + key.pem)
#
# After setup-production:
#   1. make setup-secrets
#   2. make install-ssl-certs DOMAIN=thermosolver.net EMAIL=you@example.com STOP_NGINX=1 RELOAD=1
#   3. docker compose up -d
#      (or: docker compose -f compose.production.yml up -d)
#   4. chmod 600 .env

# ==========================================
# Application
# ==========================================
NODE_ENV=production
APP_VERSION=2.0.0
API_VERSION=v1
APP_DOMAIN=thermosolver.net

# ==========================================
# Legacy System
# ==========================================
LEGACY_PORT=18080
LEGACY_VERSION=1.0.0

# ==========================================
# Database - PostgreSQL
# ==========================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=thermal_prod
# Filled by: make setup-secrets
DB_PASSWORD=CHANGE_THIS_GENERATE_SECURE_PASSWORD
DB_DATABASE=thermal_production

# ==========================================
# Cache - Redis
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# JWT Secrets
# ==========================================
# Filled by: make setup-secrets
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_GENERATE_DIFFERENT_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Ports (public HTTPS; :80 only for redirect + ACME)
# ==========================================
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=4000
FRONTEND_PORT=80
VITE_PORT=5173

# ==========================================
# API / Frontend (HTTPS domain)
# ==========================================
API_URL=http://backend:4000/api/v1
VITE_API_URL=/api/v1
VITE_ALLOWED_HOSTS=thermosolver.net,.thermosolver.net
VITE_MAIN_APP_URL=https://thermosolver.net/
VITE_SOURCE_EXTRACTOR_URL=/source-extractor/
VITE_SE_API_URL=/source-extractor/api/v1
CORS_ORIGIN=https://thermosolver.net

# ==========================================
# Docker Image Versions
# ==========================================
POSTGRES_VERSION=18.1-alpine
REDIS_VERSION=8.4-alpine
NODE_VERSION=24.13.0-alpine
NGINX_VERSION=1.28.1-alpine
PYTHON_VERSION=3.14.8-slim
PYTHON_VERSION_NUMBER=3.14
TESSERACT_VERSION=5.5.3

# ==========================================
# Docker Registry (compose.production.yml)
# ==========================================
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=CHANGE_THIS_YOUR_DOCKER_USERNAME
DOCKER_PASSWORD=CHANGE_THIS_YOUR_DOCKER_ACCESS_TOKEN
IMAGE_PREFIX=thermal
VERSION=2.0.0

# ==========================================
# SSL/TLS (required for :443)
# ==========================================
# Place Let's Encrypt files via:
#   make install-ssl-certs DOMAIN=thermosolver.net EMAIL=you@example.com STOP_NGINX=1 RELOAD=1
# → docker/nginx/ssl/cert.pem
# → docker/nginx/ssl/key.pem

# ==========================================
# Display (compose.yml python/SE mounts; unused on headless VPS)
# ==========================================
DISPLAY=:0
QT_X11_NO_MITSHM=1
XAUTHORITY=/tmp/.Xauthority

# ==========================================
# Source-extractor LLM (optional)
# ==========================================
SE_LLM_PROVIDER=google
# SE_LLM_MODEL=
# SE_LLM_API_KEY=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=warn

# ==========================================
# Checklist
# ==========================================
# ✅ make setup-production && make setup-secrets
# ✅ CORS_ORIGIN / VITE_* use https://thermosolver.net
# ✅ TLS certs in docker/nginx/ssl/
# ✅ Firewall: 80 + 443 only
# ✅ chmod 600 .env — never commit .env
