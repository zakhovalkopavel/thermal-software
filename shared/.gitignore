# But keep directories we manage
!/

# Allow these directories and their contents
!/sources/
!/processed/

# Ignore everything inside except .gitkeep (subfolders will override if needed)
/processed/*
!/processed/phase-diagrams/
!/processed/JANAF/
!/processed/compound-data/
!/processed/NASA/
!/processed/metal-data/

# Keep gitkeep files
!/sources/.gitkeep
!/processed/.gitkeep