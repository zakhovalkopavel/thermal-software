# ==========================================
# Environment Configuration
# ==========================================
# This file contains ALL configuration values
# NO defaults in Docker files or compose.yml
# Copy this to .env and customize values

# ==========================================
# Application
# ==========================================
BACKEND_PORT=4000
FRONTEND_PORT=3000
VITE_PORT=5173
HTTP_PORT=80
HTTPS_PORT=443

# ==========================================
# Database - PostgreSQL
# ==========================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=thermal
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION
DB_DATABASE=thermal

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# JWT Configuration
# ==========================================
# ⚠️ CHANGE THESE IN PRODUCTION!
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_SECRET_IN_PRODUCTION_USE_OPENSSL_RAND
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_IN_PRODUCTION
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# API Configuration
# ==========================================
API_URL=http://localhost:4000/api/v1
API_VERSION=v1
VITE_API_URL=http://localhost/api/v1
CORS_ORIGIN=*

# ==========================================
# Docker Image Versions
# Verified: February 8, 2026
# ==========================================

POSTGRES_VERSION=18.1-alpine
REDIS_VERSION=8.4-alpine
NGINX_VERSION=1.28.1-alpine
NODE_VERSION=24.13.0-alpine

# Python - Latest stable: 3.14.8
PYTHON_VERSION=3.14.8-slim
PYTHON_VERSION_NUMBER=3.14
# Tesseract OCR engine built from source in docker/python/Dockerfile (Debian ships 5.5.0)
TESSERACT_VERSION=5.5.3

# ==========================================
# Display Configuration (for OCR GUI tools)
# ==========================================
# X11 Display for GUI applications
# :0 = virtual display, :1 = actual monitor
DISPLAY=:1

# Qt X11 compatibility fix
QT_X11_NO_MITSHM=1

# X11 authentication file path (for Docker container X11 forwarding)
# Find yours with: echo $XAUTHORITY
# Common locations:
#   GDM/GNOME session : /run/user/1000/gdm/Xauthority
#   LightDM session   : /home/<user>/.Xauthority
#   SSH X forwarding  : /tmp/xauth_XXXXXX
XAUTHORITY=/run/user/1000/gdm/Xauthority

# ==========================================
# Application Versions
# ==========================================
APP_VERSION=1.0.0-dev

# ==========================================
# Docker Registry (for build and push)
# ==========================================
# Registry URL (docker.io for Docker Hub)
DOCKER_REGISTRY=docker.io

# Your Docker Hub username or private registry username
DOCKER_USERNAME=yourusername

# Docker password/token (optional - will prompt if not set)
# For Docker Hub, use access token (not password)
# Generate at: https://hub.docker.com/settings/security
# DOCKER_PASSWORD=your_access_token_here

# Image prefix (organization/project name)
IMAGE_PREFIX=thermal

# Version tag (auto-generated if not set: YYYYMMDD-HHMMSS)
# VERSION=1.0.0

# ==========================================
# Surya / llama-server (Yaws + NBS OCR)
# ==========================================
# Leave unset: Yaws uses all logical CPUs (typically 2× physical) for --threads.
# SURYA_INFERENCE_PARALLEL=1
# LLAMA_CPP_EXTRA_ARGS=--threads 12 --threads-batch 12

# Yaws OCR — required for parse/deploy (no code defaults). Copy into .env.
YAWS_OCR_BACKEND=local
YAWS_OCR_MODEL=datalab-to/surya-ocr-2.5-gguf
YAWS_OCR_QUANT=bf16
YAWS_MODAL_APP=yaws-surya-ocr
YAWS_MODAL_CLASS=SuryaOcr
YAWS_MODAL_GPU=T4
YAWS_MODAL_LLAMA_RELEASE=b12061
# CUDA llama-server asset flavor (must match a GitHub release tarball name).
YAWS_MODAL_LLAMA_FLAVOR=ubuntu-cuda-12.8-x64
# Modal tokens — create at https://modal.com/settings ; never commit real values.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

