# Keep python image builds small when context is the repo root.
.git
**/.git
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.env
.env.*
.idea
.vscode
.pytest_cache
tmp
shared
legacy
frontend
backend
docs
json
d
node_modules
**/node_modules
*.md
!python/README.md
!vendor/**/README.md

# TLS material is bind-mounted at runtime; root-owned Let's Encrypt dirs break
# `docker compose build` context walks (permission denied on accounts/).
docker/nginx/ssl
**/ssl/letsencrypt
*.pem
*.key
*.crt

